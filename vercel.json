{
  "version": 2,
  "name": "sme-crowdfund-vn",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "frontend/pages/api/**/*.js": {
      "maxDuration": 10
    }
  },
  "regions": ["sin1"]
}
