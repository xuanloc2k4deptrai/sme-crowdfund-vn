# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ENCRYPTION_KEY=your-super-secret-encryption-key-32-chars
NEXT_PUBLIC_PAYMENT_API_KEY=your-payment-api-key

# VNPay Configuration
NEXT_PUBLIC_VNPAY_API_KEY=your-vnpay-api-key
NEXT_PUBLIC_VNPAY_SECRET_KEY=your-vnpay-secret-key

# MoMo Configuration
NEXT_PUBLIC_MOMO_API_KEY=your-momo-api-key
NEXT_PUBLIC_MOMO_SECRET_KEY=your-momo-secret-key

# ZaloPay Configuration
NEXT_PUBLIC_ZALOPAY_API_KEY=your-zalopay-api-key
NEXT_PUBLIC_ZALOPAY_SECRET_KEY=your-zalopay-secret-key

# VietQR Configuration
NEXT_PUBLIC_VIETQR_API_KEY=your-vietqr-api-key
NEXT_PUBLIC_VIETQR_SECRET_KEY=your-vietqr-secret-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Security Settings
NEXT_PUBLIC_DEVICE_FINGERPRINT_ENABLED=true
NEXT_PUBLIC_FRAUD_DETECTION_ENABLED=true
NEXT_PUBLIC_2FA_ENABLED=true