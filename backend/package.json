{
  "name": "sme-crowdfund-backend",
  "version": "0.1.0",
  "description": "Backend service for SME crowdfunding platform in Vietnam.",
  "main": "dist/simple-server.js",
  "scripts": {
    "dev": "ts-node src/simple-server.ts",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:payment": "ts-node-dev --respawn --transpile-only src/secure-payment-server.ts",
    "build": "tsc",
    "start": "node dist/simple-server.js",
    "start:prod": "node dist/simple-server.js",
    "start:payment": "node dist/secure-payment-server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/axios": "^0.9.36",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "license": "MIT"
}
