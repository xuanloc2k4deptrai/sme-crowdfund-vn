# Backend Environment Variables
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Security Keys
ENCRYPTION_KEY=your-super-secret-encryption-key-32-chars-long-minimum
JWT_SECRET=your-jwt-secret-key-for-authentication
PAYMENT_API_KEY=your-payment-api-key-for-signature
WEBHOOK_SECRET=your-webhook-secret-for-validation

# Frontend URL
FRONTEND_URL=http://localhost:3000

# VNPay Configuration
VNPAY_API_KEY=your-vnpay-api-key
VNPAY_SECRET_KEY=your-vnpay-secret-key
VNPAY_WEBHOOK_SECRET=your-vnpay-webhook-secret

# MoMo Configuration
MOMO_API_KEY=your-momo-api-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_WEBHOOK_SECRET=your-momo-webhook-secret

# ZaloPay Configuration
ZALOPAY_API_KEY=your-zalopay-api-key
ZALOPAY_SECRET_KEY=your-zalopay-secret-key
ZALOPAY_WEBHOOK_SECRET=your-zalopay-webhook-secret

# VietQR Configuration
VIETQR_API_KEY=your-vietqr-api-key
VIETQR_SECRET_KEY=your-vietqr-secret-key
VIETQR_WEBHOOK_SECRET=your-vietqr-webhook-secret

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Bank Information for VietQR
BANK_ACCOUNT_NUMBER=your-bank-account-number
BANK_ACCOUNT_NAME=your-bank-account-name
BANK_BIN_CODE=your-bank-bin-code

# Redis Configuration (for production)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Email Configuration (for 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# SMS Configuration (for 2FA)
SMS_API_KEY=your-sms-api-key
SMS_SECRET_KEY=your-sms-secret-key

# Fraud Detection Settings
FRAUD_DETECTION_ENABLED=true
MAX_RISK_SCORE=70
AUTO_BLOCK_THRESHOLD=90

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# File Upload (AWS S3)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name